# .gitignore (Root of shopnish-separate)

# Node dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Build outputs
dist/
backend/dist/
frontend/dist/

# Environment variables
.env            # for backend/.env
frontend/.env   # for frontend/.env
backend/.env
# Logs
*.log
npm-debug.log*
yarn-debug.log*
lerna-debug.log*

# Editor directories and files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Caches
.eslintcache

# Additional ignored files/folders you might have removed
.replit
components.json
generated-icon.png
Untitled-1.ipynb
# etc.