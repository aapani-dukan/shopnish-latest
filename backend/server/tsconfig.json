{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    
    // यह टाइपस्क्रिप्ट को मजबूर करेगा कि वह पुरानी 'types' सेटिंग्स को भूल जाए
    "types": [], 
    
    "typeRoots": [
      "../node_modules/@types", 
      "./types"                  
    ],
    "lib": ["es2022"],
    "outDir": "../dist/server",
    "baseUrl": ".",
    "paths": {
      "shared/*": ["../../shared/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.d.ts",
    "../../shared/**/*.ts" 
  ],
  "exclude": ["node_modules", "dist"]
}